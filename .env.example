# Docker host port for app container -> container port 3000
APP_PORT=3000

# Public base URLs used by better-auth and browser client
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL container credentials/database
POSTGRES_USER=invoicenest
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=invoicenest

# Required secret for better-auth (minimum 32 characters)
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-secret
